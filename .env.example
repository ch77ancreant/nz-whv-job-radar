# Copy only if .env does not already exist; NEVER overwrite your existing keys.
APIFY_API_TOKEN=
# Only read for explicit --notify or deliver --send; numeric Chat ID, not @username.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Keep false until permission to collect/store SEEK data is actually confirmed.
# This is a user attestation, not a permission granted by this program.
SOURCE_ACCESS_CONFIRMED=false
APIFY_MAX_CHARGE_USD=0.05
APIFY_DAILY_BUDGET_USD=0.50
APIFY_TIMEOUT_SECONDS=120
